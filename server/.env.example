# ============================================================
# 云平台统一门户 · 服务端环境变量样例
# 复制为 .env 后按需修改；.env 已在 .gitignore 中，**禁止提交真实密钥**。
# 依据《云平台统一门户 API 契约 v1.0》§0.1 / §0.3 / §1.2 / §5 / §6
# ============================================================

# ---------- 运行环境 ----------
NODE_ENV=development
APP_PORT=3000
# 契约里为 <公网IP> 占位符，部署时替换；仅用于日志/回调拼接
PUBLIC_BASE_URL=http://127.0.0.1
SWAGGER_ENABLED=true

# ---------- MySQL（门户库，与云存储的 PostgreSQL 各自独立）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=portal
DB_PASSWORD=portal_pwd
DB_DATABASE=cloud_portal
DB_CHARSET=utf8mb4
DB_LOGGING=false
DB_POOL_SIZE=10

# ---------- Redis（refresh 会话 / JWT 吊销 / 限流 / 商品缓存热键）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=portal:

# ---------- 时间口径 ----------
# 接口返回的"墙上时间"按此偏移补：东八区 = 480（默认值，可不填）。
# ⚠️ 不能用服务器系统时区代替：公网 Linux 常是 UTC，会让应用写列
#    （reviewed_at / paid_at / expire_at / last_sync_at）整体少 8 小时。
DISPLAY_TZ_OFFSET_MINUTES=480

# ---------- JWT（RS256）----------
# 生成密钥：npm run keys:generate
JWT_KID=portal-2026-10
JWT_PRIVATE_KEY_FILE=./keys/jwt-private.pem
# JWT_PUBLIC_KEY_FILE 自 2026-10-28 起**可选**：验用户 token 的公钥由私钥派生，留空即可。
# 只有要塞一把与私钥不配套的公钥时才需要显式配置（极少见）。
# JWT_PUBLIC_KEY_FILE=./keys/jwt-public.pem
# 或内联（仅本地开发；\n 表示换行）
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
JWT_ISSUER=cloud-portal
# access 2h / refresh 14d（契约 §1.2）
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=1209600
# 密钥轮换期的历史公钥（仍需可验签旧 token），最多登记 3 把
# JWT_PREVIOUS_1_KID=portal-2026-09
# JWT_PREVIOUS_1_PUBLIC_KEY_FILE=./keys/jwt-public-2026-09.pem

# ---------- 鉴权与限流 ----------
# 首个管理员（2026-10-10 起管理端改用**管理员账号**，静态 X-Admin-Key 已删除）
#
# 启动时幂等创建/校准这个账号，所以它同时是「忘记密码」的找回入口：改这里重启即可。
# 之所以用环境变量而不是接口创建：否则从"服务可访问"到"首个管理员建好"之间存在时间窗，
# 谁先调到那个接口谁就是管理员。
# ⚠️ 生产必须换成强密码，且不与测试环境共用。
# ⚠️ 密码需 8-64 位且同时含字母和数字，否则引导失败（启动日志会提示，服务仍会起）。
ADMIN_USERNAME=change-me-admin
ADMIN_PASSWORD=change-me-strong-password-2026
ADMIN_PHONE=
AUTH_RATE_WINDOW=60
AUTH_RATE_MAX=10
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ---------- 公开接口限流（2026-10-09 商品列表改公开后新增）----------
# 商品列表无需登录，失去 token 这道天然门槛，因此按客户端 IP 限流。
PUBLIC_RATE_WINDOW=60
PUBLIC_RATE_MAX=120
# 商品目录查询缓存 TTL（毫秒），0 = 关闭。商品每 10 分钟同步一次，10 秒 TTL 用户无感知。
PRODUCT_LIST_CACHE_TTL_MS=10000

# ---------- 商城 / 产品对接 ----------
# 契约 §5.1：每 10 分钟全量拉取商品目录
PRODUCT_SYNC_INTERVAL_MS=600000
MAX_ITEMS_PER_ORDER=10
MAX_QUANTITY_PER_ITEM=10
PHONE_MAX_QUANTITY=3
# 契约 §5.2：provision 超时 30s（门户按失败处理并自动退款）
PROVISION_TIMEOUT_MS=30000
PRODUCT_TIMEOUT_MS=10000

# ---------- 钱包 ----------
RECHARGE_MIN_CENTS=100
RECHARGE_MAX_CENTS=10000000
# 契约 §4.1 建议退避 1s / 5s / 30s
WALLET_RETRY_BACKOFF_MS=1000,5000,30000

# ---------- 产品内网地址（仅出站）----------
#
# 2026-10-27 起（docs/27）这里**只剩地址**，不再有任何密钥：
#   ① 出站（门户 → 产品）：认证改为 **RS256 服务凭据**，由门户私钥签发，
#      产品用门户 JWKS 公钥验签 —— 所以这里不需要配任何秘密。
#   ② 入站（产品 → 门户）：认证改为产品私钥签发、门户用 `p_service_key` 表里的公钥验签。
#      产品公钥由运维 SQL 插入该表，**与这里的地址开关完全解耦**。
#
# 因此：`*_BASE_URL` 留空 = 该产品"未接入出站"（不参与商品同步与开通），
# 但**不影响它的入站调用**（扣费/退款/报账单只看 `p_service_key`，不看这里）。
#
# ⚠️ 旧变量 `*_INTERNAL_KEY` 已废弃，配了也不会被读取。留在 .env 里只是噪音，请删掉。

# 一期：云存储
PRODUCT_STORAGE_BASE_URL=http://192.168.99.100:3001

# 二期：云手机（未接入时留空）
PRODUCT_PHONE_BASE_URL=

# 三期：云电脑（技术栈待定）
PRODUCT_DESKTOP_BASE_URL=

# ---------- 服务凭据公钥缓存 ----------
# 公钥存在 `p_service_key` 表，门户按这个间隔全量重载。
# 调小 = 停用公钥（泄漏止血）生效更快；调大 = 更省数据库。
SERVICE_KEY_RELOAD_INTERVAL_MS=60000

# ---------- 本地自验专用：产品桩（不要在生产配）----------
# 只有 stub-product-server.cjs 与三套 e2e 脚本会用到。
STUB_PRODUCT_BASE_URL=http://127.0.0.1:8081
# ---------- 本地 compose 用（docker-compose.yml 读取）----------
MYSQL_ROOT_PASSWORD=portal_root_pwd
