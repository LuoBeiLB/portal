{
  "openapi": "3.0.0",
  "paths": {
    "/api/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "summary": "注册（契约 §1.1）",
        "description": "注册即建钱包（balance=0），**注册后自动登录**，data 同时返回用户档案与 access_token。\n\n同时 Set-Cookie：`refresh_token=...; Path=/api/auth/refresh; HttpOnly; SameSite=Strict; Max-Age=1209600`。\n\n错误：2001 用户名已存在、2002 手机号已注册、1001 参数校验失败（`data.errors` 有字段级原因）。",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "契约 §0.2：业务响应统一 HTTP 200，结果看 body 的 code"
          }
        },
        "tags": [
          "认证 auth"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "summary": "登录（契约 §1.2）",
        "description": "`username` 字段支持**填用户名或手机号**。成功返回 access_token（2h）并 Set-Cookie refresh_token（14 天）。\n\n错误：2003 账号或密码错误（后端不区分\"用户不存在\"与\"密码错\"，避免账号枚举）、2004 账号被禁用。",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "契约 §0.2：业务响应统一 HTTP 200，结果看 body 的 code"
          }
        },
        "tags": [
          "认证 auth"
        ]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "summary": "刷新 access token（契约 §1.3）",
        "description": "**不接收参数**，只依赖浏览器自动携带的 `refresh_token` Cookie（Path 限定为 `/api/auth/refresh`，所以前端无法手动读取它）。\n\nrefresh 不轮换、单设备语义（一期从简）。错误 1002 = refresh 无效或过期，需重新登录。",
        "parameters": [],
        "responses": {
          "200": {
            "description": "契约 §0.2：业务响应统一 HTTP 200，结果看 body 的 code"
          }
        },
        "tags": [
          "认证 auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "summary": "登出（契约 §1.4）",
        "description": "吊销该用户全部 refresh 会话并清除 Cookie；access token 按契约不做黑名单（2h 自然过期），但本实现额外把当前 access token 也标记为已吊销（收紧到\"登出即失效\"）。\n\n返回 `{ ok: true }`。需要携带 Bearer token。",
        "parameters": [],
        "responses": {
          "200": {
            "description": "契约 §0.2：业务响应统一 HTTP 200，结果看 body 的 code"
          }
        },
        "tags": [
          "认证 auth"
        ]
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "operationId": "JwksController_list",
        "summary": "JWKS 公钥集（契约 §1.5）",
        "description": "**无鉴权**，产品侧内网直连门户获取。返回标准 JWKS 结构（**不套 `{code,message,data}` 壳**）。\n\n会同时列出**当前公钥与轮换期历史公钥**，否则密钥轮换瞬间产品侧验签会全部失败。\n\n产品实现要求：启动时拉取 + 每 12h 刷新 + `kid` 不匹配时立即强制刷新。",
        "parameters": [],
        "responses": {
          "200": {
            "description": "标准 JWKS（注意：没有 code/message/data 外壳）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "keys": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kty": {
                            "type": "string",
                            "example": "RSA"
                          },
                          "alg": {
                            "type": "string",
                            "example": "RS256"
                          },
                          "use": {
                            "type": "string",
                            "example": "sig"
                          },
                          "kid": {
                            "type": "string",
                            "example": "portal-2026-10"
                          },
                          "n": {
                            "type": "string",
                            "description": "RSA modulus（base64url）"
                          },
                          "e": {
                            "type": "string",
                            "example": "AQAB"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "认证 auth"
        ]
      }
    },
    "/api/wallet/balance": {
      "get": {
        "operationId": "WalletController_balance",
        "summary": "查询余额（契约 §3.1）",
        "description": "返回 `{ balance_cents, status }`。`balance_cents` 单位**分**；`status`：0 正常 / 1 冻结（冻结时不能支付）。",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "钱包 wallet"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/wallet/transactions": {
      "get": {
        "operationId": "WalletController_transactions",
        "summary": "资金流水（契约 §3.2）",
        "description": "分页返回 `{ list, total, page, size }`，按时间倒序。`type`：1 充值 / 2 扣费 / 3 退款 / 4 调账。\n\n`created_at` 为 **UTC**（如 `2026-10-05T02:00:00Z`），前端展示前必须转本地时区；`detail` 是产品传入的任意 JSON。",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "页码，从 1 开始",
            "schema": {
              "minimum": 1,
              "default": 1,
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "size",
            "required": false,
            "in": "query",
            "description": "每页条数（上限 100）",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "example": 20,
              "type": "number"
            }
          },
          {
            "name": "page_size",
            "required": false,
            "in": "query",
            "description": "每页条数的别名（兼容 page_size / limit 写法）",
            "schema": {
              "example": 20,
              "type": "number"
            }
          },
          {
            "name": "type",
            "required": false,
            "in": "query",
            "description": "流水类型",
            "schema": {
              "example": 2,
              "enum": [
                1,
                2,
                3,
                4
              ],
              "type": "number"
            }
          },
          {
            "name": "product_code",
            "required": false,
            "in": "query",
            "description": "产品代码过滤",
            "schema": {
              "example": "storage",
              "enum": [
                "storage",
                "phone",
                "desktop"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "钱包 wallet"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/wallet/recharge/apply": {
      "post": {
        "operationId": "WalletController_applyRecharge",
        "summary": "提交充值申请（契约 §3.3）",
        "description": "一期唯一入金通道：**提交申请 → 用户线下转账 → 管理员核销 → 余额到账**，不是即时到账。\n\n金额 100 ~ 10,000,000 分。返回 `{ apply_id, status, notice }`，status：0 待核销 / 1 已到账 / 2 驳回。",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RechargeApplyDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "契约 §0.2：业务响应统一 HTTP 200，结果看 body 的 code"
          }
        },
        "tags": [
          "钱包 wallet"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/admin/recharges": {
      "get": {
        "operationId": "AdminController_listRecharges",
        "summary": "充值核销队列（契约 §6）",
        "description": "`?status=0` 只看待核销（0 待核销 / 1 已到账 / 2 驳回，缺省返回全部）。列表带 `username` / `phone` 便于核对。",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "页码，从 1 开始",
            "schema": {
              "minimum": 1,
              "default": 1,
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "size",
            "required": false,
            "in": "query",
            "description": "每页条数（上限 100）",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "example": 20,
              "type": "number"
            }
          },
          {
            "name": "page_size",
            "required": false,
            "in": "query",
            "description": "每页条数的别名（兼容 page_size / limit 写法）",
            "schema": {
              "example": 20,
              "type": "number"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "充值单状态过滤",
            "schema": {
              "example": 0,
              "enum": [
                0,
                1,
                2
              ],
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "管理端 admin"
        ],
        "security": [
          {
            "admin-key": []
          }
        ]
      }
    },
    "/api/admin/recharges/{id}/confirm": {
      "post": {
        "operationId": "AdminController_confirm",
        "summary": "核销到账 / 驳回（契约 §6.2）",
        "description": "条件更新抢占状态（`WHERE id=? AND status=0`）：**重复核销会被拒**，防止两个管理员同时点通过导致重复增额。\n\n到账会加余额并写 type=1 流水；入金失败会自动退回待核销，不会留\"已到账但没加钱\"的悬空单。\n\n`admin_id` 为审核人标识（一期由调用方传入）。",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "admin_id",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmRechargeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "契约 §0.2：业务响应统一 HTTP 200，结果看 body 的 code"
          }
        },
        "tags": [
          "管理端 admin"
        ],
        "security": [
          {
            "admin-key": []
          }
        ]
      }
    },
